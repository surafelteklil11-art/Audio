<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".AudioApplication"
        android:theme="@style/Theme.Audio"
        android:label="Audio"
        android:icon="@drawable/ic_audio"
        android:allowBackup="true">
        <provider android:name=".VaultHookProvider" android:authorities="${applicationId}.vault-hook" android:exported="false" android:initOrder="100" />
        <provider android:name=".WeeklyReportRedirectProvider" android:authorities="${applicationId}.weekly-report-redirect" android:exported="false" android:initOrder="90" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WidgetCatalogActivity" android:exported="false" />
        <activity android:name=".ThemesActivity" android:exported="false" />
        <activity android:name=".EqualizerActivity" android:exported="false" />
        <activity android:name=".DriveModeActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".SearchActivity" android:exported="false" />
        <activity android:name=".VolumeBoosterActivity" android:exported="false" />
        <activity android:name=".FullscreenVideoActivity" android:exported="false" android:screenOrientation="unspecified" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".VaultActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".WeeklyReportActivity" android:exported="false" />
        <activity android:name=".MediaActionActivity" android:exported="false" />
        <activity android:name=".AudioLibraryPageActivity" android:exported="false" />

        <receiver android:name=".WidgetActionReceiver" android:exported="false" />
        <receiver android:name=".AudioWidgetClassicProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_classic" /></receiver>
        <receiver android:name=".AudioWidgetLiteProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_lite" /></receiver>
        <receiver android:name=".AudioWidgetSimpleProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_simple" /></receiver>
        <receiver android:name=".AudioWidgetMiniProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_mini" /></receiver>
        <receiver android:name=".AudioWidgetPracticalProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_practical" /></receiver>
        <receiver android:name=".AudioWidgetFeatureRichProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_feature_rich" /></receiver>
        <receiver android:name=".AudioWidgetStandardProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_standard" /></receiver>
        <receiver android:name=".AudioWidgetStylishProvider" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_stylish" /></receiver>

        <service android:name=".PlaybackService" android:exported="true" android:stopWithTask="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService" /></intent-filter>
        </service>
    </application>
</manifest>
