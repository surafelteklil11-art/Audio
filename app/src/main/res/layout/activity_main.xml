<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg_root" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="16dp" android:paddingBottom="10dp" android:gravity="center_vertical">
            <TextView android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☰" android:textColor="#E9ECF7" android:textSize="27sp" />
            <TextView android:id="@+id/screenTitle" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="10dp" android:text="Music" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/searchButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⌕" android:textColor="#E9ECF7" android:textSize="31sp" />
            <TextView android:id="@+id/premiumButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="♛" android:textColor="#FFD978" android:textSize="23sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/musicContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="22dp" android:paddingEnd="22dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="3dp">
                    <TextView android:id="@+id/songsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Songs" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:paddingEnd="26dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/playlistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlists" android:textColor="#65718B" android:textSize="21sp" android:paddingEnd="26dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/foldersTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folders" android:textColor="#65718B" android:textSize="21sp" android:paddingEnd="26dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/artistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artists" android:textColor="#65718B" android:textSize="21sp" android:paddingEnd="26dp" android:paddingBottom="10dp" />
                    <TextView android:id="@+id/albumsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Albums" android:textColor="#65718B" android:textSize="21sp" android:paddingBottom="10dp" />
                </LinearLayout>
            </HorizontalScrollView>
            <View android:id="@+id/tabIndicator" android:layout_width="45dp" android:layout_height="3dp" android:layout_marginStart="22dp" android:background="#FF3DAA" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="9dp" android:paddingBottom="9dp">
                <TextView android:id="@+id/playAll" android:layout_width="wrap_content" android:layout_height="46dp" android:gravity="center" android:paddingStart="19dp" android:paddingEnd="19dp" android:text="▶  Play (0)" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_pill" />
                <TextView android:id="@+id/shuffleAll" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginStart="10dp" android:gravity="center" android:paddingStart="19dp" android:paddingEnd="19dp" android:text="⤨  Shuffle" android:textColor="#FFFFFF" android:textSize="16sp" android:background="@drawable/bg_pill" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingBottom="92dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/simpleContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="40dp">
                <TextView android:id="@+id/simpleIcon" android:layout_width="88dp" android:layout_height="88dp" android:gravity="center" android:text="♪" android:textColor="#FFFFFF" android:textSize="48sp" android:background="@drawable/bg_art" />
                <TextView android:id="@+id/simpleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Home" android:textColor="#FFFFFF" android:textSize="31sp" android:textStyle="bold" />
                <TextView android:id="@+id/simpleBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="Your music library" android:textColor="#A7B1C8" android:textSize="16sp" />
                <TextView android:id="@+id/simpleAction" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginTop="24dp" android:gravity="center" android:paddingStart="23dp" android:paddingEnd="23dp" android:text="Open Music" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/bg_pill" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginBottom="7dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="7dp" android:background="@drawable/bg_mini_player">
        <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="♪" android:textColor="#FFFFFF" android:textSize="28sp" android:background="@drawable/bg_art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="11dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Nothing playing" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Choose a song" android:textColor="#B5AECB" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/play" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#FFFFFF" android:contentDescription="Play or pause" />
        <TextView android:id="@+id/queueButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="☷" android:textColor="#FFFFFF" android:textSize="23sp" android:contentDescription="Queue" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="68dp" android:background="#080F27" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
        <LinearLayout android:id="@+id/homeNav" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_margin="3dp" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textColor="#6E7890" android:textSize="26sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#6E7890" android:textSize="11sp" /></LinearLayout>
        <LinearLayout android:id="@+id/musicNav" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_margin="3dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_nav_selected"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♪" android:textColor="#FFFFFF" android:textSize="26sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:id="@+id/videoNav" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_margin="3dp" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#6E7890" android:textSize="22sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" android:textColor="#6E7890" android:textSize="11sp" /></LinearLayout>
        <LinearLayout android:id="@+id/mineNav" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_margin="3dp" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#6E7890" android:textSize="22sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mine" android:textColor="#6E7890" android:textSize="11sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
