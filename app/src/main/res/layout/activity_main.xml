<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#071A43" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="18dp" android:paddingBottom="12dp" android:gravity="center_vertical">
            <TextView android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☰" android:textColor="#FFFFFF" android:textSize="30sp" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/searchButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⌕" android:textColor="#FFFFFF" android:textSize="34sp" />
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="♛" android:textColor="#FFD36A" android:textSize="25sp" />
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="30dp" android:paddingEnd="30dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/songsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Songs" android:textColor="#FFFFFF" android:textSize="25sp" android:textStyle="bold" android:paddingEnd="28dp" android:paddingBottom="10dp" />
                <TextView android:id="@+id/playlistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlists" android:textColor="#65718B" android:textSize="22sp" android:paddingEnd="28dp" android:paddingBottom="10dp" />
                <TextView android:id="@+id/foldersTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folders" android:textColor="#65718B" android:textSize="22sp" android:paddingEnd="28dp" android:paddingBottom="10dp" />
                <TextView android:id="@+id/artistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artists" android:textColor="#65718B" android:textSize="22sp" android:paddingEnd="28dp" android:paddingBottom="10dp" />
                <TextView android:id="@+id/albumsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Albums" android:textColor="#65718B" android:textSize="22sp" android:paddingBottom="10dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <View android:id="@+id/tabIndicator" android:layout_width="45dp" android:layout_height="3dp" android:layout_marginStart="30dp" android:background="#FF1592" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="30dp" android:paddingEnd="30dp" android:paddingTop="8dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/playAll" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="▶  Play (0)" android:textColor="#FFFFFF" android:textSize="18sp" android:background="@drawable/bg_pill" />
            <TextView android:id="@+id/shuffleAll" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="⤨  Shuffle" android:textColor="#FFFFFF" android:textSize="18sp" android:background="@drawable/bg_pill" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="22dp" android:paddingEnd="18dp" android:paddingBottom="105dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginStart="30dp" android:layout_marginEnd="30dp" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:background="@drawable/bg_mini_player">
        <TextView android:layout_width="50dp" android:layout_height="50dp" android:gravity="center" android:text="♪" android:textColor="#FFFFFF" android:textSize="30sp" android:background="@drawable/bg_art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Nothing playing" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a song" android:textColor="#B4A9C8" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/play" android:layout_width="52dp" android:layout_height="52dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#FFFFFF" />
        <TextView android:id="@+id/queueButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="☷" android:textColor="#FFFFFF" android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="#0B1C42" android:gravity="center">
        <LinearLayout android:id="@+id/homeNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂" android:textColor="#6E7890" android:textSize="28sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#6E7890" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/musicNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♪" android:textColor="#FFFFFF" android:textSize="28sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:id="@+id/videoNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#6E7890" android:textSize="23sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" android:textColor="#6E7890" android:textSize="12sp" /></LinearLayout>
        <LinearLayout android:id="@+id/mineNav" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#6E7890" android:textSize="24sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mine" android:textColor="#6E7890" android:textSize="12sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
