<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root"
    android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="4dp" android:gravity="center_vertical">
            <TextView android:id="@+id/menuButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="☰" android:textColor="#E9ECF7" android:textSize="25sp" />
            <TextView android:id="@+id/screenTitle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="8dp" android:text="Music" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:id="@+id/searchButton" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="⌕" android:textColor="#E9ECF7" android:textSize="28sp" />
            <TextView android:id="@+id/premiumButton" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="♛" android:textColor="#FFD978" android:textSize="21sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/musicContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="20dp" android:paddingEnd="20dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/songsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Songs" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:paddingEnd="21dp" android:paddingBottom="6dp" />
                    <TextView android:id="@+id/playlistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playlists" android:textColor="#65718B" android:textSize="18sp" android:paddingEnd="21dp" android:paddingBottom="6dp" />
                    <TextView android:id="@+id/foldersTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Folders" android:textColor="#65718B" android:textSize="18sp" android:paddingEnd="21dp" android:paddingBottom="6dp" />
                    <TextView android:id="@+id/artistsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artists" android:textColor="#65718B" android:textSize="18sp" android:paddingEnd="21dp" android:paddingBottom="6dp" />
                    <TextView android:id="@+id/albumsTab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Albums" android:textColor="#65718B" android:textSize="18sp" android:paddingBottom="6dp" />
                </LinearLayout>
            </HorizontalScrollView>
            <!-- Kept for MainActivity compatibility; indicator is intentionally invisible. -->
            <View android:id="@+id/tabIndicator" android:layout_width="1dp" android:layout_height="0dp" android:alpha="0" android:background="@android:color/transparent" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="7dp" android:gravity="center_vertical">
                <TextView android:id="@+id/playAll" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="▶ Play (0)" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_pill" />
                <TextView android:id="@+id/shuffleAll" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="⤨ Shuffle" android:textColor="#FFFFFF" android:textSize="14sp" android:background="@drawable/bg_pill" />
                <TextView android:id="@+id/sortSongs" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="⇅ Sort" android:textColor="#FFFFFF" android:textSize="13sp" android:background="@drawable/bg_pill" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingBottom="12dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/videoContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="12dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/videoCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 Videos" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tap a video to open the full-screen player" android:textColor="#8290AA" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:id="@+id/videoScan" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="↻ Scan" android:textColor="#FFFFFF" android:background="@drawable/bg_pill" />
                <TextView android:id="@+id/sortVideos" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="⇅ Sort" android:textColor="#FFFFFF" android:background="@drawable/bg_pill" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/videoList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingBottom="8dp" />
        </LinearLayout>

        <ScrollView android:id="@+id/simpleContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:id="@+id/simpleContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:id="@+id/simpleIcon" android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="♪" android:textColor="#FFFFFF" android:textSize="44sp" android:background="@drawable/bg_art" />
                <TextView android:id="@+id/simpleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Welcome to Audio" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/simpleBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#A7B1C8" android:textSize="16sp" />
                <TextView android:id="@+id/simpleAction" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginTop="22dp" android:gravity="center" android:paddingStart="22dp" android:paddingEnd="22dp" android:text="OPEN MUSIC" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_pill" />
                <LinearLayout android:id="@+id/mineProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_luxury_card" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/profileAvatar" android:layout_width="74dp" android:layout_height="74dp" android:gravity="center" android:text="A" android:textColor="#FFFFFF" android:textSize="31sp" android:textStyle="bold" android:background="@drawable/bg_profile_avatar" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="15dp"><TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Lover" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" /><TextView android:id="@+id/profileSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Enjoy Listening" android:textColor="#8794AF" android:textSize="14sp" /></LinearLayout><TextView android:id="@+id/profileEdit" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="✎" android:textColor="#FFFFFF" android:textSize="21sp" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="20dp" android:background="#26395F" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="18dp"><TextView android:id="@+id/statPlayed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♪&#10;Music Played&#10;0 Times" android:textColor="#FFFFFF" android:textSize="14sp" /><TextView android:id="@+id/statSongs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♫&#10;Storage&#10;0 Songs" android:textColor="#FFFFFF" android:textSize="14sp" /></LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp"><TextView android:id="@+id/statToday" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◷&#10;Today Played&#10;0 Times" android:textColor="#FFFFFF" android:textSize="14sp" /><TextView android:id="@+id/statTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◴&#10;Listening Time&#10;0 Mins" android:textColor="#FFFFFF" android:textSize="14sp" /></LinearLayout>
                    <TextView android:id="@+id/registerProfile" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:gravity="center" android:text="CREATE / EDIT PROFILE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_pill" />
                </LinearLayout>
                <LinearLayout android:id="@+id/weeklyReport" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginTop="14dp" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/bg_luxury_card" android:visibility="gone"><TextView android:layout_width="46dp" android:layout_height="46dp" android:gravity="center" android:text="♬" android:textColor="#FFFFFF" android:textSize="23sp" android:background="@drawable/bg_profile_avatar" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="14dp" android:text="Weekly Music Report&#10;Your week in music" android:textColor="#FFFFFF" android:textSize="16sp" /><TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="›" android:textColor="#A7B2C9" android:textSize="34sp" /></LinearLayout>
                <TextView android:id="@+id/weeklyReportDot" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center|end" android:paddingEnd="12dp" android:text="." android:textColor="#FFFFFF" android:textSize="20sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="7dp" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/bg_mini_player_clear">
        <TextView android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="♪" android:textColor="#FFFFFF" android:textSize="28sp" android:background="@drawable/bg_art" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp"><TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Ready to play" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="First song is ready" android:textColor="#D6C9E7" android:textSize="12sp" /></LinearLayout>
        <ImageButton android:id="@+id/play" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:src="@android:drawable/ic_media_play" android:tint="#FFFFFF" />
        <TextView android:id="@+id/queueButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="☷" android:textColor="#FFFFFF" android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="68dp" android:background="@android:color/transparent" android:gravity="center">
        <LinearLayout android:id="@+id/homeNav" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:includeFontPadding="false" android:text="⌂" android:textColor="#6E7890" android:textSize="19sp" android:background="@drawable/bg_nav_icon" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Home" android:textColor="#6E7890" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/musicNav" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:includeFontPadding="false" android:text="♫" android:textColor="#6E7890" android:textSize="18sp" android:background="@drawable/bg_nav_icon" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Music" android:textColor="#6E7890" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/videoNav" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:includeFontPadding="false" android:text="▶" android:textColor="#6E7890" android:textSize="16sp" android:background="@drawable/bg_nav_icon" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Video" android:textColor="#6E7890" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:id="@+id/mineNav" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:includeFontPadding="false" android:text="●" android:textColor="#6E7890" android:textSize="16sp" android:background="@drawable/bg_nav_icon" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Mine" android:textColor="#6E7890" android:textSize="10sp" /></LinearLayout>
    </LinearLayout>
</LinearLayout>
