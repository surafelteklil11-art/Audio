<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetFeatureRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp" android:background="@drawable/widget_bg_feature_rich">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/featureArtwork" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/widget_art_neon" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/featureTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Player Music" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/featureArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enjoy Listening" android:textColor="#D9D6E7" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/featureHeart" android:layout_width="30dp" android:layout_height="40dp" android:gravity="center" android:text="♡" android:textColor="#FFFFFF" android:textSize="18sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/featureProgress" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="6dp" android:max="100" android:progress="46" style="?android:attr/progressBarStyleHorizontal" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
        <TextView android:id="@+id/featureShuffle" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="↻" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/featurePrev" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="◀" android:textColor="#FFFFFF" android:textSize="15sp" />
        <TextView android:id="@+id/featurePlay" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="17sp" />
        <TextView android:id="@+id/featureNext" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/featureQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Love song  —  Taylor Swift\n2. Dancing with your ghost  —  Justin Bieber" android:textColor="#E9E7F3" android:textSize="8sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
