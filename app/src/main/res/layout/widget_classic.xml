<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetClassicRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/widget_bg_classic">
    <ImageView android:id="@+id/classicArtwork" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/widget_art_sunset" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/classicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Player" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/classicArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enjoy Listening" android:textColor="#D7DCEC" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/classicPrev" android:layout_width="34dp" android:layout_height="48dp" android:gravity="center" android:text="◀" android:textColor="#FFFFFF" android:textSize="15sp" />
    <TextView android:id="@+id/classicPlay" android:layout_width="38dp" android:layout_height="48dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="18sp" />
    <TextView android:id="@+id/classicNext" android:layout_width="34dp" android:layout_height="48dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="15sp" />
</LinearLayout>
