<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="118dp" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="8dp" android:clickable="true" android:focusable="true">
    <FrameLayout android:layout_width="164dp" android:layout_height="94dp" android:background="@drawable/bg_luxury_card">
        <com.surafel.audio.VideoThumbnailView
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/videoPlay" android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="center"
            android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textSize="20sp" android:background="@drawable/bg_profile_avatar" />
        <TextView android:id="@+id/videoDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
            android:layout_margin="6dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:text="VIDEO" android:textColor="#FFFFFF" android:textSize="10sp" android:background="#99000000" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/videoTitle" android:tag="video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#F5F7FF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/videoMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" android:textColor="#8492B0" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
